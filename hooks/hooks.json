{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/qmd-refresh.sh\"",
            "async": true,
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/retrieval-log.sh\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
