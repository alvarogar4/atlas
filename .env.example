# Atlas Configuration
# Copy to ~/.config/atlas/.env and customize values (shared by all agents)

# Path to your knowledge base (second brain)
ATLAS_BRAIN_PATH=~/brain

# Active project
ATLAS_ACTIVE_PROJECT=my-project

# Per-project external paths (optional)
# Format: ATLAS_PATH_{PROJECT_NAME_UPPERCASE}
# Use for projects that live outside {BRAIN_PATH}/projects/
# ATLAS_PATH_MYPROJECT=/path/to/external/project

# Optional search tools (skills/second-brain/reference/search-tools.md). grep is used when unset.
# QMD (github.com/tobi/qmd): ranked keyword and meaning search over an index of the notes
# ATLAS_QMD_CMD=qmd
# Obsidian CLI: links, tags and search through the running app (must be switched on in Obsidian)
# ATLAS_OBSIDIAN_CMD=/Applications/Obsidian.app/Contents/MacOS/Obsidian
